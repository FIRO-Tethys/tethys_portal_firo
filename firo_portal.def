Bootstrap: docker
From: ghcr.io/aquaveo/tethys-uvx:builder-a3148d5
Stage: build

%files
    tethysdash                                                                                          /build/tethysdash
    tethysdash_plugin_cnrfc                                                                             /build/tethysdash_plugin_cnrfc
    tethysdash_plugin_cw3e                                                                              /build/tethysdash_plugin_cw3e
    tethysdash_plugin_usace                                                                             /build/tethysdash_plugin_usace
    Custom_CW3E_Visualizations                                                                          /build/Custom_CW3E_Visualizations
    custom_themes/tethysext-default_theme                                                               /build/tethysext-default_theme
    requirements.txt                                                                                    /build/requirements.txt

    images/firo_dash_logo.png                                                                           /build/tethysdash/tethysapp/tethysdash/public/images/tethys_dash.png

    custom_themes/react/layout/App.scss                                                                 /build/tethysdash/reactapp/App.scss
    custom_themes/react/layout/content-extra.css                                                        /build/tethysdash/reactapp/components/layout/content-extra.css
    custom_themes/react/layout/cw3e-twentysixteen.css                                                   /build/tethysdash/reactapp/components/layout/cw3e-twentysixteen.css
    custom_themes/react/layout/cw3eFooter.js                                                            /build/tethysdash/reactapp/components/layout/cw3eFooter.js
    custom_themes/react/layout/cw3eHeader.js                                                            /build/tethysdash/reactapp/components/layout/cw3eHeader.js
    custom_themes/react/layout/Header.js                                                                /build/tethysdash/reactapp/components/layout/Header.js
    custom_themes/react/layout/styles.css                                                               /build/tethysdash/reactapp/components/layout/styles.css
    custom_themes/react/layout/LandingPage.js                                                           /build/tethysdash/reactapp/views/LandingPage.js
    custom_themes/react/layout/ContextMenu.js                                                           /build/tethysdash/reactapp/components/landingPage/ContextMenu.js
    custom_themes/react/layout/TooltipButton.js                                                         /build/tethysdash/reactapp/components/buttons/TooltipButton.js
    custom_themes/react/layout/index.html                                                               /build/tethysdash/tethysapp/tethysdash/templates/tethysdash/index.html

%post
    set -eux

    export TETHYS_PORTAL_HOST=""
    export TETHYS_APP_ROOT_URL="/apps/tethysdash/"
    export TETHYS_PREFIX_URL="firo_apps"
    export TETHYS_LOADER_DELAY="500"
    export TETHYS_DEBUG_MODE="false"

    cd /build/tethysdash
    mv reactapp/config/development.env reactapp/config/production.env
    sed -i "s#TETHYS_DEBUG_MODE.*#TETHYS_DEBUG_MODE = ${TETHYS_DEBUG_MODE}#g" reactapp/config/production.env
    sed -i "s#TETHYS_LOADER_DELAY.*#TETHYS_LOADER_DELAY = ${TETHYS_LOADER_DELAY}#g" reactapp/config/production.env
    sed -i "s#TETHYS_PORTAL_HOST.*#TETHYS_PORTAL_HOST = ${TETHYS_PORTAL_HOST}#g" reactapp/config/production.env
    sed -i "s#TETHYS_APP_ROOT_URL.*#TETHYS_APP_ROOT_URL = ${TETHYS_APP_ROOT_URL}#g" reactapp/config/production.env
    sed -i "s#TETHYS_PREFIX_URL.*#TETHYS_PREFIX_URL = ${TETHYS_PREFIX_URL}#g" reactapp/config/production.env

    npm install
    npm run build
    rm -rf node_modules

    uv pip install --no-cache -r /build/requirements.txt

    export SETUPTOOLS_SCM_PRETEND_VERSION_FOR_TETHYSDASH="0.19.26"
    uv pip install --no-cache /build/tethysdash

    uv pip install --no-cache /build/tethysdash_plugin_cnrfc
    uv pip install --no-cache /build/tethysdash_plugin_cw3e
    uv pip install --no-cache /build/tethysdash_plugin_usace
    uv pip install --no-cache /build/Custom_CW3E_Visualizations
    uv pip install --no-cache /build/tethysext-default_theme

    uv pip install --no-cache "social-auth-app-django>=5.9"
    uv pip install --no-cache plotly pytz numpy

    python -c "import tethysapp.tethysdash"
    python -c "import tethysdash_plugin_cnrfc, tethysdash_plugin_cw3e, tethysdash_plugin_usace"
    python -c "import tethysext.default_theme"

    python - <<'SMOKE'
import importlib.metadata as md, sys
missing = {}
for ep in md.entry_points(group="intake.drivers"):
    try:
        ep.load()
    except Exception as e:
        missing[ep.name] = f"{type(e).__name__}: {e}"
if missing:
    for name, err in sorted(missing.items()):
        print(f"intake driver {name}: {err}", file=sys.stderr)
    sys.exit(1)
SMOKE


Bootstrap: docker
From: ghcr.io/aquaveo/tethys-uvx:runtime-base-a3148d5
Stage: final

%files from build
    /opt/python                                                                                         /opt/python
    /opt/conda                                                                                          /opt/conda

%files
    conf/portal_config.yml                                                                              /config/portal_config.yml
    conf/init.d                                                                                         /opt/portal/init.d

    custom_themes/tethysext-default_theme/tethysext/default_theme/templates/default_theme/base.html      /portal-overlays/base.html
    custom_themes/tethysext-default_theme/tethysext/default_theme/templates/default_theme/header_gen.html /portal-overlays/header.html
    custom_themes/tethysext-default_theme/tethysext/default_theme/templates/default_theme/footer_gen.html /portal-overlays/footer.html
    custom_themes/tethysext-default_theme/tethysext/default_theme/templates/admin/base_site.html         /portal-overlays/admin_base_site.html

%post
    set -eux

    SP="$(/opt/conda/envs/tethys/bin/python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"
    TPL="${SP}/tethys_portal/templates"

    test -d "${TPL}"
    install -m 0644 /portal-overlays/base.html   "${TPL}/base.html"
    install -m 0644 /portal-overlays/header.html "${TPL}/header.html"
    install -m 0644 /portal-overlays/footer.html "${TPL}/footer.html"
    install -D -m 0644 /portal-overlays/admin_base_site.html "${TPL}/admin/base_site.html"
    rm -rf /portal-overlays

    mkdir -p "${SP}/tethysapp/tethysdash/resources"
    ln -sfn /home/tethys/persist/workspaces/tethysdash "${SP}/tethysapp/tethysdash/workspaces"

    chmod -R a+rX /opt/python /opt/conda /config /opt/portal

%environment
    export PREFIX_URL="/firo_apps"
    export MEDIA_URL="/media/"
    export TETHYS_PORT=8000
    export ASGI_PROCESSES=4

%startscript
    exec /usr/local/bin/serve.sh

%runscript
    cat <<'EOF'
firo-portal (tethys-uvx)

  serve      apptainer instance start <sif> firo_portal
  provision  apptainer exec <sif> /usr/local/bin/provision.sh
  config     apptainer exec <sif> /usr/local/bin/portal-config.sh
  static     apptainer exec <sif> /usr/local/bin/publish-static.sh
EOF

%labels
    Author aquaveollc
    BaseImage ghcr.io/aquaveo/tethys-uvx:a3148d5
