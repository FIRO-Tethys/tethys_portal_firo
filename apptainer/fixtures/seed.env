# Fixture seed values for the production-shaped baseline.
#
# This file exists to make the fixture WRONG in the ways production might be wrong.
# Convenient defaults would make the migration pass without proving anything, so
# several values below are deliberately awkward. Read the comments before changing one.

# ---- Portal superuser -------------------------------------------------------
# MUST NOT be "admin". The tethys-uvx provision verb defaults to creating
# admin/pass, and create_portal_superuser only catches the collision when the
# names match. A fixture seeded as "admin" hides that hole and the migration
# passes against the bug. Any other name exercises it.
FIXTURE_SUPERUSER_NAME=firoadmin
FIXTURE_SUPERUSER_PASSWORD=fixture-super-pw
FIXTURE_SUPERUSER_EMAIL=firoadmin@example.invalid

# A second, non-privileged account. Proves ordinary users survive the cutover,
# not just the one we happen to be watching.
FIXTURE_USER_NAME=cw3euser
FIXTURE_USER_PASSWORD=fixture-user-pw
FIXTURE_USER_EMAIL=cw3euser@example.invalid

# ---- Site branding ----------------------------------------------------------
# Non-default values written to the DB so we can prove `tethys site -f` leaves
# undeclared settings alone. If these matched the defaults the check is vacuous.
FIXTURE_SITE_TITLE="FIRO Fixture Portal"
FIXTURE_BRAND_TEXT="FIRO Fixture"
FIXTURE_PRIMARY_COLOR="#8b1e6b"

# ---- Media ------------------------------------------------------------------
# Fixed-content files placed alongside whatever tethysdash writes, so checksums
# are stable across rebuilds. The real thumbnail comes from creating a dashboard.
FIXTURE_MEDIA_FILLER_COUNT=5
